TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
DOWNLOAD_DIR=./downloads
MAX_DOWNLOAD_MB=1900

# Optional: helps when Instagram blocks anonymous reel/post access.
# Export cookies from a browser session in Netscape cookies.txt format.
INSTAGRAM_COOKIES_FILE=
HOST_INSTAGRAM_COOKIES_FILE=

# Optional: local Telegram Bot API server settings.
# Required only when using docker compose with the telegram-bot-api service.
TELEGRAM_API_ID=your_telegram_api_id_here
TELEGRAM_API_HASH=your_telegram_api_hash_here
TELEGRAM_API_BASE_URL=http://telegram-bot-api:8081/bot
TELEGRAM_API_BASE_FILE_URL=http://telegram-bot-api:8081/file/bot
TELEGRAM_LOCAL_MODE=true
